# AI Radar 환경 변수 템플릿
# 복사하여 .env 로 이름을 변경한 후 실제 값을 입력하세요.

# GitHub 개인 액세스 토큰 (GitHub Search API 한도 30회/분 보장용, 미입력시 분당 10회 제한)
GITHUB_TOKEN=

# Slack 알림용 설정 (선택 사항)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# 카카오톡 웹훅 (비우면 로컬/사설망 클라이언트만 허용)
KAKAO_WEBHOOK_SECRET=
# 허용 방 이름(쉼표 구분). 비우면 전체 수용. 방 이름에 우선 키워드가 있으면 항상 허용
KAKAO_ALLOWED_ROOMS=
KAKAO_PRIORITY_ROOM_KEYWORDS=AI,에이전트,스킬,트렌드

# Slack 알림 기준
SLACK_MIN_SCORE=10
SLACK_DAILY_LIMIT=30
